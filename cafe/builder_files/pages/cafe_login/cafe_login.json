         "innerHTML": "<form id=\"cafe-email-form\" novalidate=\"novalidate\"><div ><label for=\"cafe-email\" style=\"display:block;margin-bottom:6px;font-size:14px;font-weight:420;color:#7c7c7c;letter-spacing:0.02em;line-height:1.15\"><span >Email</span><span style=\"color:#e03434\"> *</span></label><input class=\"cafe-auth-input\" id=\"cafe-email\" name=\"email\" type=\"email\" placeholder=\"name@example.com\" autocomplete=\"email\" required=\"required\" autofocus=\"autofocus\" style=\"display:block;width:100%;height:28px;padding:6px 8px;border:1px solid #f3f3f3;border-radius:8px;outline:none;background-color:#f3f3f3;color:#171717;font-size:14px;letter-spacing:0.02em\"></div><div class=\"cafe-auth-error\" id=\"cafe-email-error\" role=\"alert\" hidden=\"hidden\" style=\"margin-top:12px;font-size:13px;font-weight:420;color:#b41d1d;letter-spacing:0.02em;line-height:1.15\"></div><p class=\"cafe-signup-hint\" hidden=\"hidden\" style=\"margin:8px 0 0;font-size:13px;font-weight:420;color:#7c7c7c;letter-spacing:0.02em;line-height:1.15\"><a class=\"cafe-auth-link\" href=\"/signup\" style=\"font-weight:500;color:#0f0f0f;text-decoration:underline\">Create one.</a></p><button class=\"cafe-auth-btn-solid\" type=\"submit\" id=\"cafe-send\" style=\"display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:28px;padding:0 8px;border-radius:8px;font-size:14px;letter-spacing:0.02em;cursor:pointer;margin-top:16px;border:0;background-color:#171717;color:#ffffff\"><span >Send verification code</span></button><button class=\"cafe-auth-btn-outline\" type=\"button\" id=\"cafe-google\" style=\"display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:28px;padding:0 8px;border-radius:8px;font-size:14px;letter-spacing:0.02em;cursor:pointer;margin-top:8px;border:1px solid #e2e2e2;background-color:#ffffff;color:#171717\"><svg viewBox=\"0 0 48 48\" width=\"16\" height=\"16\" aria-hidden=\"true\" style=\"display:block;flex-shrink:0\"><path fill=\"#FFC107\" d=\"M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z\"/><path fill=\"#FF3D00\" d=\"m6.3 14.7 6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.6 8.3 6.3 14.7z\"/><path fill=\"#4CAF50\" d=\"M24 44c5.5 0 10.4-2.1 14.1-5.6l-6.5-5.5C29.6 34.7 26.9 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z\"/><path fill=\"#1976D2\" d=\"M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.4l6.5 5.5C41.5 35.7 44 30.4 44 24c0-1.3-.1-2.7-.4-3.5z\"/></svg><span >Continue with Google</span></button></form><form id=\"cafe-code-form\" hidden=\"hidden\" novalidate=\"novalidate\"><p style=\"margin:0;font-size:13px;font-weight:420;color:#7c7c7c;letter-spacing:0.015em;line-height:19.5px\"><span >We sent a 6 digit verification code to </span><span id=\"cafe-sent-to\"></span></p><div style=\"display:flex;gap:8px;margin-top:16px\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 1\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 2\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 3\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 4\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 5\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"><input class=\"cafe-otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"1\" aria-label=\"Digit 6\" style=\"width:48px;height:48px;padding:8px 12px;border:1px solid #e2e2e2;border-radius:10px;outline:none;background-color:#ffffff;color:#0f0f0f;text-align:center;font-size:16px;font-weight:500;letter-spacing:0.015em\"></div><div class=\"cafe-auth-error\" id=\"cafe-code-error\" role=\"alert\" hidden=\"hidden\" style=\"margin-top:12px;font-size:13px;font-weight:420;color:#b41d1d;letter-spacing:0.02em;line-height:1.15\"></div><button class=\"cafe-auth-btn-solid\" type=\"submit\" id=\"cafe-verify\" style=\"display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:28px;padding:0 8px;border-radius:8px;font-size:14px;letter-spacing:0.02em;cursor:pointer;margin-top:16px;border:0;background-color:#171717;color:#ffffff\"><span >Verify</span></button><p class=\"cafe-resend\" style=\"margin:12px 0 0;text-align:center;font-size:13px;font-weight:420;color:#7c7c7c;letter-spacing:0.02em;line-height:1.15\"></p></form>",
