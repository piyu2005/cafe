             "innerHTML": "<template id=\"cafe-feed-template\" data-avatar-image=\"&lt;img src=&quot;[[image]]&quot; alt=&quot;&quot; style=&quot;width:100%;height:100%;object-fit:cover&quot;&gt;\" data-thumbnail=\"&lt;img class=&quot;cafe-feed-thumb&quot; src=&quot;[[cover]]&quot; alt=&quot;&quot; loading=&quot;lazy&quot; decoding=&quot;async&quot; style=&quot;width:128px;height:96px;flex-shrink:0;margin-top:4px;border-radius:10px;background-color:#f3f3f3;object-fit:cover&quot;&gt;\"><a class=\"cafe-feed-row\" href=\"[[href]]\" style=\"display:flex;flex-direction:column;gap:12px;padding:36px 0;color:inherit;text-decoration:none\"><div class=\"cafe-feed-author\" style=\"display:flex;align-items:center;gap:8px\"><span class=\"cafe-avatar\" style=\"display:grid;place-items:center;flex-shrink:0;width:20px;height:20px;overflow:hidden;border-radius:9999px;background-color:#f3f3f3;font-size:13px;font-weight:500;color:#7c7c7c;letter-spacing:0.02em;line-height:1.15;text-transform:uppercase\">[[!avatar]]</span><span style=\"font-size:13px;font-weight:420;color:#171717;letter-spacing:0.02em;line-height:1.15\">[[name]]</span></div><div style=\"display:flex;align-items:flex-start;gap:16px\"><div style=\"flex:1 1 0%;min-width:0\"><div style=\"font-size:16px;font-weight:600;color:#171717;letter-spacing:0.015em;line-height:1.15\">[[title]]</div><p class=\"cafe-clamp-2\" style=\"margin:4px 0 0;font-size:14px;font-weight:420;color:#525252;letter-spacing:0.02em;line-height:1.5\">[[excerpt]]</p><div style=\"display:flex;align-items:center;gap:12px;margin-top:16px;font-size:12px;font-weight:420;color:#7c7c7c;letter-spacing:0.02em;line-height:1.15\"><span >[[date]]</span><span >·</span><span >[[minutes]] min read</span><span >·</span><span class=\"cafe-feed-comments\">[[comments]] comments</span></div></div>[[!thumbnail]]</div></a></template>",
